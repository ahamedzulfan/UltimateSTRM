<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Jellyfin.Plugin.UltimateStrm</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.UltimateStrm</AssemblyName>
    <Version>0.1.0.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin these to the exact server version (10.11.11) you are building against -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />

    <!-- Shared sqlite store used by Strm, Yt2Strm and CustomIframe -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the single tabbed config page so it ships inside the plugin DLL -->
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
